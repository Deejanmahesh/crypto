# Copy to .env to run the backend outside Docker.

# Postgres (Docker compose default). For local Postgres adjust host/port.
DATABASE_URL=postgresql+asyncpg://crypto:crypto@localhost:5432/crypto
# For a zero-setup local run you can instead use SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./crypto.db

COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Optional CoinGecko Demo API key (raises the free rate limit). Leave blank for public access.
COINGECKO_API_KEY=

TOP_N_ASSETS=10
HISTORY_DAYS=30
INGEST_INTERVAL_MINUTES=10
INGEST_ON_STARTUP=true

CORS_ORIGINS=http://localhost:3000
